# Copy to `.env` at the repo root and adjust as needed.
#   cp .env.example .env             (bash)
#   Copy-Item .env.example .env      (PowerShell)
#
# Optional for Phase 0 — the API has working defaults for everything here.
# Nothing below is secret; these are local development defaults only.

# ─── Application ──────────────────────────────────────────
ENVIRONMENT=development

# Comma-separated. The Vite dev server proxies /api, so this is a fallback
# for anyone hitting the API directly from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ─────────────────────────────────────────────
# Running the database on another machine? Change this one line to that
# machine's IP address. Nothing else needs to change.
DB_HOST=localhost

# These rarely change.
DB_PORT=5432
DB_USER=homelander
DB_PASSWORD=devpassword
DB_NAME=homelander

# ─── Sign-in ──────────────────────────────────────────────
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-do-not-use-in-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

# ─── Built-in accounts ────────────────────────────────────
# Three accounts, one per staff role, all with the password below:
#
#   underwriter   Underwriter
#   medical       Medical Professional
#   admin         Administrator
#
# They work with no database at all, so a demo survives the database machine
# being unreachable.
#
# Already on in development — you do not need to set anything. They are ignored
# outside development, and clearing ADMIN_PASSWORD switches all three off.
# (ADMIN_USERNAME is no longer read; an old one left in your .env is harmless.)
ADMIN_PASSWORD=admin123

# ─── Mammogram reader (Mirai) ─────────────────────────────
# Mirai runs on a teammate's server, not here. Point this at it; leave it empty
# and the reader is switched off and says so.
MIRAI_URL=http://34.173.36.245:5000/serve
# The server is on someone else's machine and has been seen to drop the
# connection part-way through a 100 MB upload. After this many seconds the
# application is scored without the mammogram, and the screen says it timed out
# rather than pretending the reading is missing for some other reason.
MIRAI_TIMEOUT_SECONDS=60
# A stand-in for that server, for recording a demonstration while it is down.
#
# OFF unless you set it. It does not read the mammogram: it produces a
# plausible five-year risk derived from the applicant, so each one gets their
# own stable number and the tiers can be shown. The four views are still
# required and still checked, so the flow on screen is the real flow.
#
# Everything it produces is marked as simulated — on the review screen, in the
# stored reading and in the audit log. Never set this on anything but a demo.
MIRAI_SIMULATE=false

# ─── Outgoing mail (client portal) ────────────────────────
# Sends applicants their portal sign-in, and a note when a decision is recorded.
# Leave SMTP_HOST empty to send nothing: the operator is shown the credentials
# on screen instead, and the message is logged with the password removed.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, and an app password
# (not your account password) in SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Homelander AI <no-reply@homelander.local>
PORTAL_URL=http://localhost:5173/portal
