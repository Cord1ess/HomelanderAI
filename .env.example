# Copy to `.env` at the repo root and adjust as needed.
#   cp .env.example .env      (bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# Nothing below is secret — these are local development defaults only.
# The API reads this file automatically; no shell exports needed.

# ─── Application ──────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API ──────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated. The Vite dev server proxies /api, so this is a fallback
# for anyone hitting the API directly from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── PostgreSQL ─────────────────── used from Phase 1 ─────
POSTGRES_USER=homelander
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=homelander
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://homelander:devpassword@localhost:5432/homelander

# ─── Redis ──────────────────────── used from Phase 1 ─────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── MinIO (object storage) ─────── used from Phase 1 ─────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=homelander-evidence
MINIO_SECURE=false

# ─── Auth ───────────────────────── used from Phase 1 ─────
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-do-not-use-in-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
