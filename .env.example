# Copy to `.env` at the repo root and adjust as needed.
#   cp .env.example .env             (bash)
#   Copy-Item .env.example .env      (PowerShell)
#
# Optional for Phase 0 — the API has working defaults for everything here.
# Nothing below is secret; these are local development defaults only.

# ─── Application ──────────────────────────────────────────
ENVIRONMENT=development

# Comma-separated. The Vite dev server proxies /api, so this is a fallback
# for anyone hitting the API directly from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── PostgreSQL ───────────────────────────────────────────
# Read by docker-compose.yml only. The API does not connect to Postgres yet —
# DATABASE_URL gets added here when the first model and driver land in Phase 1.
POSTGRES_USER=homelander
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=homelander
POSTGRES_PORT=5432
