# Copy to `.env` at the repo root and adjust as needed.
#   cp .env.example .env             (bash)
#   Copy-Item .env.example .env      (PowerShell)
#
# Optional for Phase 0 — the API has working defaults for everything here.
# Nothing below is secret; these are local development defaults only.

# ─── Application ──────────────────────────────────────────
ENVIRONMENT=development

# Comma-separated. The Vite dev server proxies /api, so this is a fallback
# for anyone hitting the API directly from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ─────────────────────────────────────────────
# Running the database on another machine? Change this one line to that
# machine's IP address. Nothing else needs to change.
DB_HOST=localhost

# These rarely change.
DB_PORT=5432
DB_USER=homelander
DB_PASSWORD=devpassword
DB_NAME=homelander

# ─── Sign-in ──────────────────────────────────────────────
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-do-not-use-in-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30

# ─── Built-in admin ───────────────────────────────────────
# Sign in as `admin` / `admin123`. Works with no database at all, so a demo
# survives the database machine being unreachable.
#
# Already on in development — you do not need to set anything. It is ignored
# outside development, and clearing ADMIN_PASSWORD switches it off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
