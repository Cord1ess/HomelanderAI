{
  "name": "homelander",
  "private": true,
  "version": "0.1.0",
  "description": "HomelanderAI — underwriting decision-support platform (dev orchestration)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix apps/web install",
    "setup": "npm install && uv sync --directory apps/api",
    "dev": "concurrently -n api,web -c cyan,magenta -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run --directory apps/api uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck": "npm --prefix apps/web run typecheck",
    "lint": "npm --prefix apps/web run lint && uv run --directory apps/api ruff check .",
    "format": "uv run --directory apps/api ruff format .",
    "test": "uv run --directory apps/api pytest -q",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "gen:api": "npm --prefix apps/web run gen:api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
